{
  "title": "Job Queue Dashboard",
  "panels": [
    {
      "type": "stat",
      "title": "Jobs Submitted",
      "targets": [
        { "expr": "jobs_total" }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs Done",
      "targets": [
        { "expr": "worker_jobs_processed_total" }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs in DLQ",
      "targets": [
        { "expr": "jobs_dlq" }
      ]
    },
    {
      "type": "stat",
      "title": "Worker Jobs Processed",
      "targets": [
        { "expr": "worker_jobs_processed_total" }
      ]
    },
    {
      "type": "stat",
      "title": "Worker Jobs failed",
      "targets": [
        { "expr": "worker_jobs_failed_total" }
      ]
    },
    {
      "type": "stat",
      "title": "Worker Jobs failed",
      "targets": [
        { "expr": "worker_jobs_in_progress" }
      ]
    }
  ]
}
